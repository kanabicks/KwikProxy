{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kwik",
  "version": "0.7.1",
  "identifier": "com.kwik.vpn-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kwik",
        "width": 460,
        "height": 920,
        "minWidth": 420,
        "minHeight": 760,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kwik"]
      }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/kanabicks/KwikProxy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQTJCMDc0QUI2NjA1QUMKUldTc0JXYXJkTENpLzYvMnZDUUZqeHBlVHZ0TjNIb2d3aHJtdjBIUEpQNWZiZnQ1UTJ5b1IwTVAK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "publisher": "Kwik",
    "shortDescription": "VPN-клиент на Mihomo",
    "longDescription": "Лёгкий VPN-клиент для Windows на базе Mihomo. Поддержка VLESS, VMess, Trojan, Shadowsocks, Hysteria2, TUIC, WireGuard, AnyTLS. Подключение в один клик через системный прокси или TUN.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mihomo"
    ],
    "resources": {
      "binaries/wintun.dll": "wintun.dll",
      "binaries/kwik-helper-x86_64-pc-windows-msvc.exe": "kwik-helper-x86_64-pc-windows-msvc.exe",
      "binaries/geoip.dat": "resources/geoip.dat",
      "binaries/geosite.dat": "resources/geosite.dat"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
